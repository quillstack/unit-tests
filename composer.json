{
    "name": "quillstack/unit-tests",
    "description": "A simple library for unit testing in PHP 8.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "quillstack",
        "php",
        "php8",
        "unit",
        "tests"
    ],
    "homepage": "https://quillstack.org/unit-tests",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "bin": [
        "bin/unit-tests"
    ],
    "autoload": {
        "psr-4": {
            "Quillstack\\UnitTests\\": "src/",
            "Quillstack\\UnitTests\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "quillstack/local-storage": "^0.3",
        "quillstack/di": "^0.3",
        "quillstack/test-coverage": "^0.3"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": "php bin/unit-tests",
        "test:coverage": "phpdbg -qrr php bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
